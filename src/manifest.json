{
  "manifest_version": 3,
  "name": "Gmail Filter Helper",
  "version": "1.0",
  "permissions": [
	"storage",
	"scripting"
	],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageWorld.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}